# Copy this file to .env and fill in real values before starting the server.

PORT=4000

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=changeme_generate_a_long_random_secret

# The shared family PIN. Plaintext here (this file must never be committed / must be
# readable only by the deploy user); the server hashes it in memory at boot and never
# writes the plaintext anywhere else.
FAMILY_PIN=changeme

# NOTE: Prisma resolves this path relative to prisma/schema.prisma, not the project root,
# so "../data/..." here actually lands at backend/data/family.db (kept alongside uploads).
DATABASE_URL="file:../data/family.db"
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=300

# Set to the real web dashboard origin in production, e.g. https://family.example.com
CORS_ORIGIN=*
